{
  "name": "soundline",
  "private": true,
  "version": "0.1.0",
  "description": "A scroll-driven 3D product page for a made-up pair of headphones. Three.js, GSAP ScrollTrigger, Lenis and TypeScript.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/three": "0.186.0",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  }
}
